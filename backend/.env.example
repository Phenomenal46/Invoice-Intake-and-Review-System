LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
CORS_ORIGINS=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
