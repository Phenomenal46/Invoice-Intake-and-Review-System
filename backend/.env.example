MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=doc_workflow
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
# WARNING: Never commit your real API key to GitHub! Keep it secret!
GEMINI_API_KEY=
