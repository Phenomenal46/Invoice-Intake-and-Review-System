MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=doc_workflow
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
# WARNING: Never commit your real API key to GitHub! Keep it secret!
GEMINI_API_KEY=
# The model we use: gemini-2.5-flash is fast and good for beginners
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
# Comma-separated frontend origins: keep localhost for dev and add your Vercel URL for production.
CORS_ORIGINS=http://localhost:5173,https://invoice-intake-and-review-system.vercel.app/
# Use local uploads in development and Cloudinary in production.
STORAGE_MODE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
